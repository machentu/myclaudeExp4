//#endif
  return;
}

// IDMA Interrupt callback function
void intrCallbackFunc(void *pCallBackStr)
{
  //printf("INTERRUPT CALLBACK : processing iDMA interrupt\n");
  ((intrCbDataStruct *) pCallBackStr)->intrCount++;

  return;
}
