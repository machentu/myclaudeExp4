XI_ERR_TYPE ResizeMain(xvFrame *inFrame, xvFrame *outFrame, float scalex,float scaley)//, int planeSize)
{
//	printf_dsp("ResizeMain entering %f %f\n", scalex, scaley);
//	xvTileManager *pxvTM = &xvTMObj;

	// initialize
	Context ctx;
//	uint32_t cycleStart = _time_stamp();
	Initialize(&ctx, inFrame, outFrame, scalex, scaley);//, planeSize);
//	uint32_t cycles = _time_stamp() - cycleStart;
//	printf_dsp("Initialize cycles = %d\n", cycles);
//	printf_dsp("init done\n");

	// schedule the first input DMA
	tdma *pCur = &ctx.tdmas[0];
//	dma_2d_sys2loc(pCur->isrc_ptr, pCur->idst_ptr, pCur->irow_size, pCur->isrc_pitch,
//			pCur->idst_pitch, pCur->inum_rows);
//	dma_barrier();

	int dmaIdx;
    dmaIdx = xvAddIdmaRequest(pxvTM,        //ptr to tile manager
    		pCur->idst_ptr,                //dst
			pCur->isrc_ptr,                //src
			pCur->irow_size,   //row bytes
			pCur->inum_rows,                //number of rows
			pCur->isrc_pitch,              //src_pitch
			pCur->idst_pitch,              //dst_pitch
            0);
    xvWaitForiDMA(pxvTM, dmaIdx);

	PadTile(pCur);

//	printf("resize 1\n");


	// loop for tiles
	int i;
	for ( i = 0; i < ctx.num_loop - 1; i++, pCur++) {
		// pre-schedule next input DMA
		tdma* pNext = pCur + 1;
//		dma_2d_sys2loc(pNext->isrc_ptr, pNext->idst_ptr, pNext->irow_size,
//				pNext->isrc_pitch, pNext->idst_pitch, pNext->inum_rows);
	    dmaIdx = xvAddIdmaRequest(pxvTM,        //ptr to tile manager
	    		pNext->idst_ptr,                //dst
				pNext->isrc_ptr,                //src
				pNext->irow_size,   //row bytes
				pNext->inum_rows,                //number of rows
				pNext->isrc_pitch,              //src_pitch
				pNext->idst_pitch,              //dst_pitch
	            0);
		// run resize kernel
	    processCurrent(pCur, ctx.x_scale, ctx.y_scale);
//		if(bResize > 0)
//		{
//			xiResizeBilinear2_U8_Q13_18(pCur->itile, pCur->otile, ctx.x_scale, ctx.y_scale, 0, 0);
//		}else
//		{
//			xiCopyTile(pCur->itile, pCur->otile, 1);
//		}
//		dma_barrier();
//	    printf("after process\n");

	    xvWaitForiDMA(pxvTM, dmaIdx);

		// schedule output DMA
		//printf("OutDMA: %d, %d, %d, %d\n", pCur->orow_size, pCur->onum_rows, pCur->osrc_pitch, pCur->odst_pitch);
//		dma_2d_loc2sys(pCur->osrc_ptr, pCur->odst_ptr, pCur->orow_size,
//				pCur->osrc_pitch, pCur->odst_pitch, pCur->onum_rows);
	    dmaIdx = xvAddIdmaRequest(pxvTM,        //ptr to tile manager
	    		pCur->odst_ptr,                //dst
				pCur->osrc_ptr,                //src
				pCur->orow_size,   //row bytes
				pCur->onum_rows,                //number of rows
				pCur->osrc_pitch,              //src_pitch
				pCur->odst_pitch,              //dst_pitch
	            0);
		// padding for next tile
		PadTile(pNext);
	}

//	printf_dsp("resize 2\n");

	// run resize kernel for the last tile
	processCurrent(pCur, ctx.x_scale, ctx.y_scale);
//	if(bResize > 0)
//	{
//		xiResizeBilinear2_U8_Q13_18(pCur->itile, pCur->otile, ctx.x_scale, ctx.y_scale, 0, 0);
//	}else
//	{
//		xiCopyTile(pCur->itile, pCur->otile, 1);
//	}
//	dma_2d_sys2loc(pCur->osrc_ptr, pCur->odst_ptr, pCur->orow_size,
//			pCur->osrc_pitch, pCur->odst_pitch, pCur->onum_rows);
//	dma_barrier();

    dmaIdx = xvAddIdmaRequest(pxvTM,        //ptr to tile manager
    		pCur->odst_ptr,                //dst
			pCur->osrc_ptr,                //src
			pCur->orow_size,   //row bytes
			pCur->onum_rows,                //number of rows
			pCur->osrc_pitch,              //src_pitch
			pCur->odst_pitch,              //dst_pitch
            0);
    xvWaitForiDMA(pxvTM, dmaIdx);

//	printf_dsp("resize 3\n");
//
//	tdma *p_tdma;
//	for ( i = 0; i < ctx.num_loop; i++) {
//			p_tdma = &(ctx.tdmas[i]);
//
//			xvFreeTile(pxvTM, p_tdma->otile);
//			xvFreeTile(pxvTM, p_tdma->itile);
//	}
//	xvFreeBuffer(pxvTM, pBankBuffPool0);
//	xvFreeBuffer(pxvTM, pBankBuffPool1);

//	arena_reset();
//	return XI_ERROR_STATUS();
    return XI_ERR_OK;
}


int InitTileMrg()
{
//	xvTileManager *pxvTM = &xvTMObj;

	int32_t retVal;
	  void *buffPool[2] = {0};
	  int32_t buffSize[2] = {0};

	retVal = xvInitIdma(pxvTM, (idma_buffer_t *) idmaObjBuff, DMA_DESCR_CNT, MAX_BLOCK_16, MAX_PIF, (idma_err_callback_fn)errCallbackFunc, intrCallbackFunc, (void *) &cbData);
	if (retVal == XVTM_ERROR)
	{
	  printf_dsp("xvInitIdma failed\n");
	xvGetErrorInfo(pxvTM);
	return(RET_ERROR);
	}
//	printf_dsp("run 2 aa\n");

	// Initialize tile manager
	retVal = xvInitTileManager(pxvTM, (void *) idmaObjBuff);
	if (retVal == XVTM_ERROR)
	{
	  printf_dsp("xvInitTileManager failed\n");

	xvGetErrorInfo(pxvTM);
	return(RET_ERROR);
	}
//	printf_dsp("run 3\n");

	// Initializing Memory allocator
	buffPool[0] = pBankBuffPool0;
	buffPool[1] = pBankBuffPool1;
	buffSize[0] = POOL_SIZE0;
	buffSize[1] = POOL_SIZE1;
	retVal      = xvInitMemAllocator(pxvTM, 2, buffPool, buffSize);
	if (retVal == XVTM_ERROR)
	{
	  printf_dsp("xvInitMemAllocator failed\n");
	xvGetErrorInfo(pxvTM);
	return(RET_ERROR);
	}
//	printf_dsp("run 4\n");

	return 0;
}
